# ──────────────────────────────────────────────
# OpticBin — .gitignore
# ──────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
.venv/
env/

# Model Weights (large binary files)
models/weights/*.pt
models/weights/*.onnx
models/weights/*.onnx.data
!models/weights/.gitkeep
!models/weights/mobilevit_xs.pt
!models/weights/mobilevit_xs_int8.onnx
!models/weights/efficientnetv2_s_int8.onnx
!models/weights/efficientnetv2_s.pt



# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Datasets & Downloads
dataset/
dataset_temp/
*.zip

# Streamlit
.streamlit/

# Logs
*.log

# Evaluation results (generated by evaluate.py — keep directory, ignore outputs)
results/*.json
results/*.txt
!results/.gitkeep
